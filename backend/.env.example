# Server Settings
PORT=5000
NODE_ENV=development

# Supabase Credentials (Dapatkan dari Dashboard Supabase: Project Settings -> API)
# Project URL:
SUPABASE_URL="https://your-project-id.supabase.co"
# Project API Key (Gunakan 'service_role' secret untuk backend agar bebas RLS, atau 'anon' key):
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# JWT Auth Secret & Expiry
JWT_SECRET="siap_pengajian_jwt_secret_key_2026_super_secure"
JWT_EXPIRES_IN="2h"

# Frontend Origin for CORS
CLIENT_URL="http://localhost:5173"
