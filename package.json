{
  "name": "citra-system-information",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistem Informasi & Absensi Pengajian (SIAP)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm run dev --prefix frontend",
